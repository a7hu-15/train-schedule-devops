extends layout

block content
  .app-container
    // Dynamic Island Header Notification Capsule
    .dynamic-island-container
      .dynamic-island.d-flex.align-items-center
        i.fas.fa-circle.text-success.mr-2.fa-xs(style="animation: pulse 2s infinite;")
        span.font-weight-semibold.small.mr-3 Indian Railways Live Status & Route Distance Hub
        span.text-muted.x-small.mr-3 |
        span.font-weight-bold.text-white.small#liveClock --:--:--

    // Apple Navbar Header
    header.main-header.d-flex.justify-content-between.align-items-center.mb-4
      .brand-title.d-flex.align-items-center
        .apple-logo-icon.mr-3
          i.fas.fa-train.text-warning.fa-lg
        div
          span.font-weight-bold.text-white.h5.mb-0.letter-spacing-tight RailPulse
          span.d-block.x-small.text-muted All-India Train, Route & Distance Engine
      
      // macOS Segmented Control Bar
      ul.nav.apple-segmented-nav#mainTabs(role="tablist")
        li.nav-item
          a.nav-link.active#commuter-tab(data-toggle="tab", href="#commuter-view", role="tab")
            i.fas.fa-search-location.mr-2
            span Route & Distance Finder
        li.nav-item
          a.nav-link#map-tab(data-toggle="tab", href="#map-view", role="tab")
            i.fas.fa-map-marked-alt.mr-2
            span Network Map
        li.nav-item#operator-nav-item(style="display: none;")
          a.nav-link#operator-tab(data-toggle="tab", href="#operator-view", role="tab")
            i.fas.fa-sliders-h.mr-2
            span Dispatcher Desk
        li.nav-item#sre-nav-item(style="display: none;")
          a.nav-link#sre-tab(data-toggle="tab", href="#sre-view", role="tab")
            i.fas.fa-shield-alt.mr-2
            span System Health & SRE

      .d-flex.align-items-center
        button.btn.btn-outline-light.apple-btn-pill.mr-2(data-toggle="modal", data-target="#subscribeModal")
          i.fas.fa-bell.mr-1.text-warning
          span Alerts
        
        button.btn.btn-primary.apple-btn-pill#btnStaffLogin(data-toggle="modal", data-target="#operatorAuthModal")
          i.fas.fa-user-lock.mr-1
          span Staff Sign In
        
        button.btn.btn-outline-danger.apple-btn-pill#btnStaffLogout(style="display: none;")
          i.fas.fa-sign-out-alt.mr-1
          span Sign Out

    // Alert Banner Container
    #globalAlertContainer.mb-4

    // Main Content Views
    .tab-content#tabContent
      // ==========================================
      // VIEW 1: ROUTE & DISTANCE FINDER (COMMUTER VIEW)
      // ==========================================
      .tab-pane.fade.show.active#commuter-view(role="tabpanel")
        // Route, Train No & Distance Search Controls
        .apple-card.p-4.mb-4
          h6.font-weight-bold.text-white.mb-3
            i.fas.fa-compass.text-warning.mr-2
            span Where Is My Train - Route, Distance & Train No Search
          .form-row
            .form-group.col-md-3.col-12.mb-2
              label.x-small.text-muted FROM (ORIGIN STATION / CITY)
              .position-relative
                i.fas.fa-map-pin.apple-search-icon
                input.form-control.apple-search-input#routeOriginInput(type="text", placeholder="e.g. Delhi, Jaipur, Mumbai...")
            .form-group.col-md-3.col-12.mb-2
              label.x-small.text-muted TO (DESTINATION STATION / CITY)
              .position-relative
                i.fas.fa-flag-checkered.apple-search-icon
                input.form-control.apple-search-input#routeDestInput(type="text", placeholder="e.g. Jaipur, Agra, Varanasi...")
            .form-group.col-md-3.col-12.mb-2
              label.x-small.text-muted TRAIN NUMBER OR NAME
              .position-relative
                i.fas.fa-search.apple-search-icon
                input.form-control.apple-search-input#trainSearchInput(type="text", placeholder="e.g. 12015, 12957, Shatabdi...")
            .form-group.col-md-3.col-12.mb-2
              label.x-small.text-muted MAX ROUTE DISTANCE (KM)
              .position-relative
                i.fas.fa-road.apple-search-icon
                input.form-control.apple-search-input#distanceInput(type="number", min="0", placeholder="e.g. 500, 1000 km...")

          .d-flex.flex-wrap.align-items-center.justify-content-between.mt-2
            .quick-routes.mb-2
              span.x-small.text-muted.mr-2 Presets:
              button.btn.btn-xs.btn-outline-info.apple-btn-pill.mr-1.mb-1.btn-quick-route(data-from="Delhi", data-to="Jaipur", data-km="") Delhi ➔ Jaipur (308 km)
              button.btn.btn-xs.btn-outline-info.apple-btn-pill.mr-1.mb-1.btn-quick-route(data-from="Mumbai", data-to="Delhi", data-km="") Mumbai ➔ Delhi (1384 km)
              button.btn.btn-xs.btn-outline-warning.apple-btn-pill.mr-1.mb-1.btn-quick-dist(data-maxkm="500") Short (< 500 km)
              button.btn.btn-xs.btn-outline-warning.apple-btn-pill.mr-1.mb-1.btn-quick-dist(data-maxkm="1000") Medium (500-1000 km)
              button.btn.btn-xs.btn-outline-secondary.apple-btn-pill.mr-1.mb-1.btn-quick-route(data-from="", data-to="", data-km="") Reset
            
            button.btn.btn-primary.apple-btn-pill.px-4#btnSearchRoute
              i.fas.fa-search.mr-2
              span Search Trains

        // Summary Bar
        .apple-card.mb-4.p-4
          .row.text-center
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted.letter-spacing-wide MATCHING TRAINS
              span.h3.font-weight-bold.text-white#totalTrainsCount 0
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted.letter-spacing-wide ON TIME
              span.h3.font-weight-bold.text-success#onTimeCount 0
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted.letter-spacing-wide DELAYED
              span.h3.font-weight-bold.text-warning#delayedCount 0
            .col-md-3.col-6
              span.d-block.x-small.text-muted.letter-spacing-wide CANCELLED
              span.h3.font-weight-bold.text-danger#cancelledCount 0

        #commuterTrainGrid.row

      // ==========================================
      // VIEW 2: NETWORK MAP
      // ==========================================
      .tab-pane.fade#map-view(role="tabpanel")
        .apple-card.p-4.mb-4
          .d-flex.justify-content-between.align-items-center.mb-3
            div
              h5.font-weight-bold.mb-0 All-India Rail Corridor Topology
              p.x-small.text-muted.mb-0 Live track node status and real-time train positioning across major Indian routes.
            span.badge.badge-success.apple-btn-pill.p-2
              i.fas.fa-broadcast-tower.mr-1
              span Network Operational

          .apple-map-box.py-5.px-3.my-4.position-relative
            .route-line
            .d-flex.justify-content-between.align-items-center.position-relative(style="z-index: 2;")
              .station-node.text-center
                .node-circle.bg-success
                  i.fas.fa-building.text-white
                span.d-block.font-weight-bold.mt-2.small Delhi (0 km)
                span.x-small.text-muted Northern Hub
              .station-node.text-center
                .node-circle.bg-info
                  i.fas.fa-subway.text-white
                span.d-block.font-weight-bold.mt-2.small Jaipur (308 km)
                span.x-small.text-muted Western Line
              .station-node.text-center
                .node-circle.bg-warning
                  i.fas.fa-exchange-alt.text-white
                span.d-block.font-weight-bold.mt-2.small Kanpur (440 km)
                span.x-small.text-muted Central Junction
              .station-node.text-center
                .node-circle.bg-primary
                  i.fas.fa-flag-checkered.text-white
                span.d-block.font-weight-bold.mt-2.small Mumbai (1384 km)
                span.x-small.text-muted Southern Corridor

          .mt-4
            h6.font-weight-bold.mb-3 Running Trains
            #mapTrainList.row

      // ==========================================
      // VIEW 3: DISPATCHER DESK (STAFF ONLY)
      // ==========================================
      .tab-pane.fade#operator-view(role="tabpanel")
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h5.text-white.mb-0 Dispatcher Operations Desk
            p.x-small.text-muted.mb-0 Update train statuses, adjust delay minutes, select disruption reasons, or re-assign platforms live.
          div
            span.badge.badge-success.mr-2.p-2#operatorAuthStatus
              i.fas.fa-lock-open.mr-1
              span Staff Authenticated
            button.btn.btn-success.btn-sm.apple-btn-pill#btnOpenAddTrainModal(data-toggle="modal", data-target="#addTrainModal")
              i.fas.fa-plus-circle.mr-2
              span Add Schedule

        .apple-card.p-3.mb-4
          .table-responsive
            table.table.table-apple.table-hover.mb-0#operatorTable
              thead
                tr
                  th Train No.
                  th Train Name
                  th Route & Distance
                  th Sched.
                  th Platform
                  th Status
                  th Delay (Mins)
                  th Disruption Reason
                  th Actions
              tbody#operatorTableBody
                tr
                  td(colspan="9").text-center.text-muted Loading dispatch data...

        .apple-card.p-4
          .d-flex.justify-content-between.align-items-center.mb-3
            span.font-weight-bold
              i.fas.fa-history.text-info.mr-2
              span Operational Security Audit Log
            span.badge.badge-info.apple-btn-pill Audit Active
          .table-responsive(style="max-height: 200px; overflow-y: auto;")
            table.table.table-apple.table-sm.table-striped.mb-0
              thead
                tr
                  th Timestamp
                  th Action
                  th Operational Details
                  th Role
              tbody#auditLogsTableBody
                tr
                  td(colspan="4").text-center.text-muted Loading security audit history...

      // ==========================================
      // VIEW 4: SYSTEM HEALTH & SRE (STAFF ONLY)
      // ==========================================
      .tab-pane.fade#sre-view(role="tabpanel")
        .apple-card.p-4.mb-4
          .d-flex.justify-content-between.align-items-center.mb-3
            span.font-weight-bold
              i.fas.fa-chart-line.text-success.mr-2
              span System Observability & Service Metrics
            span.badge.badge-success.apple-btn-pill Target: 99.9% Availability
          .row.text-center.mt-3
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted AVAILABILITY UPTIME
              span.h3.font-weight-bold.text-success#sloAvailabilityVal 99.94%
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted SYNTHETIC LATENCY
              span.h3.font-weight-bold.text-info#synthP95Val 18ms
            .col-md-3.col-6.border-right.border-secondary
              span.d-block.x-small.text-muted ERROR BUDGET
              span.h3.font-weight-bold.text-primary#sloBudgetVal 98.2%
            .col-md-3.col-6
              span.d-block.x-small.text-muted DISRUPTION COUNT
              span.h3.font-weight-bold.text-warning#sloMttrVal 0

        .row
          .col-md-6.mb-4
            .apple-card.h-100
              .d-flex.justify-content-between.align-items-center.mb-3
                span.font-weight-bold
                  i.fas.fa-heartbeat.text-danger.mr-2
                  span Liveness Probe (/health)
                span.badge#livenessBadge.badge-success Healthy
              p.x-small.text-muted Controls application instance health status returned to Kubernetes pod probes.
              .mb-3
                span.d-block.x-small.text-muted PROBE RESPONSE:
                code.d-block.p-2.bg-black.rounded#livenessResponseJson Loading...
              .d-flex
                button.btn.btn-danger.btn-block.mr-2.apple-btn-pill#btnBreakApp
                  i.fas.fa-skull.mr-2
                  span Inject Failure (/break)
                button.btn.btn-success.btn-block.mt-0.apple-btn-pill#btnRestoreApp
                  i.fas.fa-check-circle.mr-2
                  span Restore Health (/restore)

          .col-md-6.mb-4
            .apple-card.h-100
              .d-flex.justify-content-between.align-items-center.mb-3
                span.font-weight-bold
                  i.fas.fa-microchip.text-info.mr-2
                  span HPA Stress Tester (/generate-cpu-load)
                span.badge.badge-info.apple-btn-pill Autoscaling Test
              p.x-small.text-muted Triggers intensive CPU loop calculations to test Kubernetes Horizontal Pod Autoscaling (HPA).
              .mb-3
                span.d-block.x-small.text-muted EXECUTION RESULT:
                code.d-block.p-2.bg-black.rounded#cpuResultJson Ready to test...
              button.btn.btn-warning.btn-block.apple-btn-pill#btnCpuStress
                i.fas.fa-bolt.mr-2
                span Run CPU Load Test

        .row
          .col-12
            .apple-card
              .d-flex.align-items-center.mb-2
                i.fas.fa-terminal.mr-2.text-warning
                span.font-weight-bold Real-Time Probe Log Monitor
              pre.p-3.bg-black.text-success.rounded.small.mb-0#sreLogTerminal(style="height: 160px; overflow-y: auto;") System initialized. Monitoring metrics...

  // ==========================================
  // MODALS (Apple & Where Is My Train Styling)
  // ==========================================

  // Where Is My Train - Station Timeline Modal
  .modal.fade#timelineModal(tabindex="-1", role="dialog", aria-hidden="true")
    .modal-dialog.modal-lg.modal-dialog-centered(role="document")
      .modal-content.apple-modal.text-white
        .modal-header.border-0.pb-2
          div
            h5.modal-title.font-weight-bold.mb-0#timelineTrainTitle Train Schedule Timeline
            p.x-small.text-muted.mb-0#timelineTrainSub Distance, Halts & Operating Days
          button.close.text-white(type="button", data-dismiss="modal") &times;
        .modal-body.py-3
          #timelineContent
        .modal-footer.border-0.pt-0
          button.btn.btn-secondary.apple-btn-pill(type="button", data-dismiss="modal") Close

  // Staff Login Modal (Passcode: 8899)
  .modal.fade#operatorAuthModal(tabindex="-1", role="dialog", aria-hidden="true")
    .modal-dialog.modal-dialog-centered(role="document")
      .modal-content.apple-modal.text-white
        .modal-header.border-0.pb-0
          h5.modal-title.font-weight-bold
            i.fas.fa-user-shield.mr-2.text-warning
            span Staff Mode Sign In
          button.close.text-white(type="button", data-dismiss="modal") &times;
        .modal-body.py-4
          p.small.text-muted Enter your Staff Passcode to unlock Dispatcher Operations & System Health controls.
          form#operatorAuthForm
            .form-group.mb-0
              label.x-small.text-muted PASSCODE (DEFAULT: 8899)
              input.form-control.apple-modal-input#operatorPinInput(type="password", placeholder="Enter Passcode", required)
              .invalid-feedback#authErrorMsg Invalid passcode. Access denied.
        .modal-footer.border-0.pt-0
          button.btn.btn-secondary.apple-btn-pill(type="button", data-dismiss="modal") Cancel
          button.btn.btn-primary.apple-btn-pill#btnSubmitAuth(type="button") Authenticate

  // Passenger Alert Subscription Modal
  .modal.fade#subscribeModal(tabindex="-1", role="dialog", aria-hidden="true")
    .modal-dialog.modal-dialog-centered(role="document")
      .modal-content.apple-modal.text-white
        .modal-header.border-0.pb-0
          h5.modal-title.font-weight-bold
            i.fas.fa-bell.mr-2.text-warning
            span Subscribe to Delay Alerts
          button.close.text-white(type="button", data-dismiss="modal") &times;
        .modal-body.py-4
          form#subscribeForm
            .form-group
              label.x-small.text-muted EMAIL ADDRESS
              input.form-control.apple-modal-input#subEmail(type="email", placeholder="commuter@example.com", required)
            .form-group
              label.x-small.text-muted SELECT TRAIN SCHEDULE
              select.form-control.apple-modal-input#subTrainId
                option(value="ALL") All Trains & Disruption Alerts
                option(value="TR-12015") Ajmer Shatabdi (12015)
                option(value="TR-12957") Swarna Jayanti Rajdhani (12957)
                option(value="TR-22436") Vande Bharat Express (22436)
                option(value="TR-12951") Mumbai Rajdhani (12951)
            .form-group.mb-0
              label.x-small.text-muted ALERT THRESHOLD
              select.form-control.apple-modal-input#subThreshold
                option(value="0") Any Delay or Platform Change
                option(value="5") Delay > 5 minutes
                option(value="15") Delay > 15 minutes
        .modal-footer.border-0.pt-0
          button.btn.btn-secondary.apple-btn-pill(type="button", data-dismiss="modal") Close
          button.btn.btn-warning.apple-btn-pill#btnSaveSubscribe(type="button") Enable Alerts

  // Dispatch Edit Modal
  .modal.fade#dispatchModal(tabindex="-1", role="dialog", aria-hidden="true")
    .modal-dialog.modal-dialog-centered(role="document")
      .modal-content.apple-modal.text-white
        .modal-header.border-0.pb-0
          h5.modal-title.font-weight-bold
            i.fas.fa-edit.mr-2.text-primary
            span Dispatcher Update: 
            span#modalTrainTitle
          button.close.text-white(type="button", data-dismiss="modal") &times;
        .modal-body.py-4
          form#dispatchForm
            input(type="hidden", id="dispatchTrainId")
            .form-group
              label.x-small.text-muted STATUS
              select.form-control.apple-modal-input#dispatchStatus
                option(value="ON-TIME") ON-TIME
                option(value="DELAYED") DELAYED
                option(value="CANCELLED") CANCELLED
            .form-row
              .form-group.col-md-6
                label.x-small.text-muted DELAY MINUTES
                input.form-control.apple-modal-input#dispatchDelayMins(type="number", min="0", value="0")
              .form-group.col-md-6
                label.x-small.text-muted PLATFORM
                input.form-control.apple-modal-input#dispatchPlatform(type="text", placeholder="e.g. Platform 2")
            .form-group.mb-0
              label.x-small.text-muted DISRUPTION REASON
              select.form-control.apple-modal-input.mb-2#dispatchPresetReason
                option(value="None") None (On-Time)
                option(value="Signaling Fault at Station Junction") Signaling Fault at Station Junction
                option(value="Mechanical & Brake Inspection") Mechanical & Brake Inspection
                option(value="Track Maintenance & Debris Clear") Track Maintenance & Debris Clear
                option(value="Platform Overcrowding & Reassignment") Platform Overcrowding & Reassignment
                option(value="Custom") Custom Reason...
              input.form-control.apple-modal-input#dispatchCustomReason(type="text", placeholder="Type custom disruption reason...", style="display:none;")
        .modal-footer.border-0.pt-0
          button.btn.btn-secondary.apple-btn-pill(type="button", data-dismiss="modal") Cancel
          button.btn.btn-primary.apple-btn-pill#btnSaveDispatch(type="button") Broadcast Update

  // Add Train Modal
  .modal.fade#addTrainModal(tabindex="-1", role="dialog", aria-hidden="true")
    .modal-dialog.modal-dialog-centered(role="document")
      .modal-content.apple-modal.text-white
        .modal-header.border-0.pb-0
          h5.modal-title.font-weight-bold
            i.fas.fa-plus-circle.mr-2.text-success
            span Add Train Schedule
          button.close.text-white(type="button", data-dismiss="modal") &times;
        .modal-body.py-4
          form#addTrainForm
            .form-group
              label.x-small.text-muted TRAIN NAME
              input.form-control.apple-modal-input#newTrainName(type="text", placeholder="e.g. Vande Bharat Express", required)
            .form-row
              .form-group.col-md-6
                label.x-small.text-muted TRAIN NUMBER
                input.form-control.apple-modal-input#newTrainNum(type="text", placeholder="e.g. 20977")
              .form-group.col-md-6
                label.x-small.text-muted PLATFORM
                input.form-control.apple-modal-input#newPlatform(type="text", placeholder="e.g. Platform 1")
            .form-row
              .form-group.col-md-6
                label.x-small.text-muted ORIGIN
                input.form-control.apple-modal-input#newOrigin(type="text", placeholder="e.g. Delhi (NDLS)")
              .form-group.col-md-6
                label.x-small.text-muted DESTINATION
                input.form-control.apple-modal-input#newDest(type="text", placeholder="e.g. Jaipur (JP)")
            .form-row
              .form-group.col-md-6
                label.x-small.text-muted DISTANCE (KM)
                input.form-control.apple-modal-input#newDistanceKm(type="number", min="1", placeholder="e.g. 308")
              .form-group.col-md-6
                label.x-small.text-muted TRAVEL DURATION
                input.form-control.apple-modal-input#newDuration(type="text", placeholder="e.g. 4h 30m")
            .form-group.mb-0
              label.x-small.text-muted SCHEDULED DEPARTURE TIME
              input.form-control.apple-modal-input#newScheduledTime(type="text", placeholder="e.g. 06:10 AM", required)
        .modal-footer.border-0.pt-0
          button.btn.btn-secondary.apple-btn-pill(type="button", data-dismiss="modal") Cancel
          button.btn.btn-success.apple-btn-pill#btnAddTrainSave(type="button") Save Schedule