# RailPulse India — Environment Configuration Template

# Database Configuration
DATABASE_URL=postgresql://railpulse:railpulse_pass@localhost:5432/railpulse_db

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0

# RailRadar Live API Key (Get yours at https://railradar.in/docs)
# Leave empty or omit to fallback to local SimulatorProvider
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://railradar.in/api/v1
